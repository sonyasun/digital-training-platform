/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/**/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable

# 课件外链会迭代：不可走 assets 长缓存，否则 iframe 样式/文案钉死一年
/assets/student/courseware/*
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS 会迭代更新：不可长缓存。缺失路径若被 SPA 回退成 HTML，长缓存会把「假样式表」钉死一周。
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
